#!/bin/sh
# pwrman-sleep -- quiesce recording/storage, then ask MCU to cut SoC power.

CONF=/etc/pwrman.conf
[ -r "$CONF" ] && . "$CONF"
MCU=${MCU:-$(command -v mcu_test 2>/dev/null || echo /usr/bin/mcu_test)}
LOG=/var/log/pwrman.log
SD=/mnt/mmcblk0p1
PROFILE=${PROFILE:-pir}

log() {
	mkdir -p /var/log
	printf '%s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$*" >> "$LOG"
}
is_mounted() {
	grep -q " $SD " /proc/mounts
}

log "sleep requested profile=$PROFILE"

case "$PROFILE" in
	pir|pir_cloud|pir_local) ;;
	*) log "invalid PROFILE=$PROFILE"; exit 1 ;;
esac

if ! "$MCU" --pir_enable >/dev/null 2>&1; then
	log "sleep aborted: PIR enable failed"
	exit 1
fi
log "PIR verified enabled"

case "$PROFILE" in
	pir_cloud) log "network wake: vendor AJCloud P2P (no local arm)" ;;
	pir_local) log "network wake: local MCU dashboard listener" ;;
	*) log "network wake: disabled (PIR only)" ;;
esac

if is_mounted; then
	if [ "${WAIT_SEGMENT_END:-1}" = "1" ] && pidof rmr >/dev/null 2>&1; then
		current=$(find "$SD/raptor" -type f -name '*.mp4' -printf '%T@ %p\n' 2>/dev/null | sort -n | tail -1 | cut -d' ' -f2-)
		if [ -n "$current" ]; then
			log "waiting for segment boundary: $current"
			deadline=$(( $(date +%s) + 120 ))
			while [ "$(date +%s)" -lt "$deadline" ]; do
				newest=$(find "$SD/raptor" -type f -name '*.mp4' -printf '%T@ %p\n' 2>/dev/null | sort -n | tail -1 | cut -d' ' -f2-)
				if [ -n "$newest" ] && [ "$newest" != "$current" ]; then
					log "segment boundary reached"
					break
				fi
				sleep 1
			done
			if [ "$(date +%s)" -ge "$deadline" ]; then
				log "segment boundary not reached; aborting sleep"
				exit 1
			fi
		fi
	fi
	log "stopping recorder"
	if ! /etc/init.d/S33rmr stop >>"$LOG" 2>&1; then
		log "recorder did not stop; aborting sleep"
		exit 1
	fi
	if pidof rmr >/dev/null 2>&1; then
		log "recorder still running; aborting sleep"
		exit 1
	fi
	sync
	if ! umount "$SD"; then
		log "SD unmount failed; aborting sleep"
		exit 1
	fi
	log "SD unmounted"
else
	log "SD not mounted; skipping recorder stop"
fi

sync
log "calling master_poweroff"
"$MCU" --master_poweroff
rc=$?
log "master_poweroff returned rc=$rc"
exit "$rc"
