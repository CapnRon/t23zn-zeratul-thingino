#!/bin/sh
# S10clock -- set the SoC UTC clock from the MCU SDIO clock before networking.

LOG=/var/log/boot-timing.log

log() {
	mkdir -p /var/log
	awk '{printf "%.3f ", $1}' /proc/uptime >> "$LOG"
	echo "clock: $*" >> "$LOG"
}

start() {
	[ -e /run/clock.ready ] && return 0
	[ -x /usr/bin/atbm-time ] || return 0
	[ -e /dev/atbm_ioctl ] || {
		log "atbm ioctl missing"
		return 0
	}

	/usr/bin/atbm-at 'AT+SNTP_SET ZONE 0' >/dev/null 2>&1 || true
	sleep 1
	before=$(date +%s)
	out=$(/usr/bin/atbm-time -s -o 0 2>&1)
	rc=$?
	printf '%s\n' "$out" >>"$LOG"
	utc=$(printf '%s\n' "$out" | sed -n 's/^utc=//p' | tail -1)
	if [ "$rc" -eq 0 ] && [ -n "$utc" ] && [ "$utc" -ge 1600000000 ] 2>/dev/null; then
		log "clock set from MCU ($utc)"
	else
		date -u -s "@$before" >/dev/null 2>&1 || true
		log "MCU clock invalid (${utc:-none}); keep build time"
	fi
}

case "$1" in
	start) start ;;
	stop) true ;;
	restart) start ;;
	*) echo "Usage: $0 {start|stop|restart}" >&2; exit 1 ;;
esac

exit 0
