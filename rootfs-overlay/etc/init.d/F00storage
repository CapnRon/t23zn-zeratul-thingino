#!/bin/sh
# F00storage -- mount the recording card and start rmr before rcS networking.

MNT=/mnt/mmcblk0p1
CONF=/etc/raptor.conf
LOG=/var/log/boot-timing.log

log() {
	mkdir -p /var/log
	awk '{printf "%.3f ", $1}' /proc/uptime >> "$LOG"
	echo "f00storage: $*" >> "$LOG"
}

start() {
	mkdir -p "$MNT"

	i=0
	while [ "$i" -lt 20 ]; do
		if grep -q " $MNT " /proc/mounts; then
			break
		fi
		for dev in /dev/mmcblk0p1 /dev/mmcblk1p1; do
			[ -b "$dev" ] || continue
			for fstype in exfat vfat; do
				if mount -t "$fstype" -o rw,noatime "$dev" "$MNT"; then
					log "mounted $dev ($fstype) at $MNT"
					break 2
				fi
			done
		done
		usleep 100000
		i=$((i + 1))
	done

	if ! grep -q " $MNT " /proc/mounts; then
		log "no SD card"
		return 0
	fi

	mkdir -p "$MNT/raptor"

	# Move the pre-SD RAM segment onto the card, then continue on SD.
	if pidof rmr >/dev/null 2>&1; then
		killall rmr 2>/dev/null || true
		i=0
		while pidof rmr >/dev/null 2>&1 && [ "$i" -lt 30 ]; do
			sleep 0.1
			i=$((i + 1))
		done
		if pidof rmr >/dev/null 2>&1; then
			killall -9 rmr 2>/dev/null || true
		fi
		if [ -d /dev/shm/raptor ]; then
			cp -a /dev/shm/raptor/. "$MNT/raptor/" 2>/dev/null || true
			sync
		fi
		log "RAM segment migrated"
	fi

	if ! pidof rmr >/dev/null 2>&1; then
		TZ=UTC start-stop-daemon -S -b -x /usr/bin/rmr -- -c "$CONF"
		sleep 1
		if pidof rmr >/dev/null 2>&1; then
			log "rmr SD started (pid $(pidof rmr))"
		else
			log "rmr SD failed to start"
		fi
	fi
}

case "$1" in
	start)
		start
		;;
	stop)
		killall rmr 2>/dev/null || true
		;;
	restart)
		killall rmr 2>/dev/null || true
		sleep 1
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}" >&2
		exit 1
		;;
esac

exit 0
