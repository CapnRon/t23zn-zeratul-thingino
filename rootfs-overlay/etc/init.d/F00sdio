#!/bin/sh
# F00sdio -- load MMC/ATBM and disable MCU WDT after recording starts.

LOG=/var/log/boot-timing.log

log() {
	mkdir -p /var/log
	awk '{printf "%.3f ", $1}' /proc/uptime >> "$LOG"
	echo "f00sdio: $*" >> "$LOG"
}

start() {
	mkdir -p /var/log /run
	grep -q ' /dev ' /proc/mounts || mount -t devtmpfs devtmpfs /dev 2>/dev/null
	log "s09 chain start"
	/etc/init.d/S09mmc start >>"$LOG" 2>&1 || log "S09 failed"
	modprobe mmc_block 2>/dev/null || log "mmc_block load failed"
	if [ -e /run/s09.done ]; then
		log "s09 chain done; wdt disabled"
	else
		log "s09 chain done; WDT NOT disabled"
	fi
}

case "$1" in
	start)
		start
		;;
	stop)
		true
		;;
	restart)
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}" >&2
		exit 1
		;;
esac

exit 0
