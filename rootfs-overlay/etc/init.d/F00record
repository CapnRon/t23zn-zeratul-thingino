#!/bin/sh
# F00record -- record the pre-SD window into /dev/shm.

CONF=/etc/raptor.conf
RAMCONF=/var/run/rss/raptor-ram.conf
RAMDIR=/dev/shm/raptor
LOG=/var/log/boot-timing.log

log() {
	mkdir -p /var/log
	awk '{printf "%.3f ", $1}' /proc/uptime >> "$LOG"
	echo "f00record: $*" >> "$LOG"
}

start() {
	mkdir -p "$RAMDIR"
	cp "$CONF" "$RAMCONF"
	sed -i 's|^storage_path.*|storage_path = /dev/shm/raptor|' "$RAMCONF"
	TZ=UTC start-stop-daemon -S -b -x /usr/bin/rmr -- -c "$RAMCONF"
	log "rmr RAM started"
}

case "$1" in
	start)
		start
		;;
	stop)
		killall rmr 2>/dev/null || true
		;;
	restart)
		killall rmr 2>/dev/null || true
		sleep 1
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}" >&2
		exit 1
		;;
esac

exit 0
