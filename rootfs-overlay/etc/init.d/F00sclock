#!/bin/sh
# Start the non-blocking MCU clock service after rmr has started.

case "$1" in
	start)
		[ -x /usr/bin/clock-service ] && /usr/bin/clock-service &
		;;
	stop)
		true
		;;
	restart)
		[ -x /usr/bin/clock-service ] && /usr/bin/clock-service &
		;;
	*)
		echo "Usage: $0 {start|stop|restart}" >&2
		exit 1
		;;
esac
exit 0
