#!/bin/sh
# S31raptor -- Raptor Streaming System init script

CONF=/etc/raptor.conf
RUNDIR=/var/run/rss
SHMDIR=/dev/shm

# Read a boolean from raptor.conf: config_bool <section> <key> <default>
config_bool() {
	val=$(raptorctl config get "$1" "$2" 2>/dev/null | tr -d '\r\n')
	val=$(printf '%s' "${val:-$3}" | tr 'A-Z' 'a-z')
	case "$val" in
		true | yes | 1 | on) return 0 ;;
		*) return 1 ;;
	esac
}

# Start a daemon, report status: start_daemon <name> [env_prefix]
start_daemon() {
	name=$1
	shift
	if [ ! -x "/usr/bin/$name" ]; then
		printf "  %-4s skipped (not installed)\n" "$name"
		return
	fi
	if ! config_bool "$(daemon_section $name)" "enabled" "$(daemon_default_enabled $name)"; then
		printf "  %-4s disabled\n" "$name"
		return
	fi
	if [ $# -gt 0 ]; then
		env "$@" start-stop-daemon -S -b -x /usr/bin/$name -- -c "$CONF"
	else
		start-stop-daemon -S -b -x /usr/bin/$name -- -c "$CONF"
	fi
	if [ $? -eq 0 ]; then
		printf "  %-4s started\n" "$name"
	else
		printf "  %-4s FAILED\n" "$name"
	fi
}

# Map daemon name to config section and default enabled state
daemon_section() {
	case $1 in
		rvd) echo "sensor" ;;
		rsd) echo "rtsp" ;;
		rsd-555) echo "rtsp" ;;
		rad) echo "audio" ;;
		rhd) echo "http" ;;
		rod) echo "osd" ;;
		ric) echo "ircut" ;;
		rmr) echo "recording" ;;
		rmd) echo "motion" ;;
		rwd) echo "webrtc" ;;
		rwc) echo "webcam" ;;
		rsp) echo "push" ;;
		rsr) echo "srt" ;;
		*) echo "$1" ;;
	esac
}

daemon_default_enabled() {
	case $1 in
		rmr | rmd | rwc | rsp | rsr | rsd-555) echo "false" ;;
		*) echo "true" ;;
	esac
}

start_rvd() {
	mkdir -p "$RUNDIR"

	if ! pidof rvd >/dev/null 2>&1; then
		# Zeratul platform: /proc/jz/sensor is not populated, so seed the
		# identity of the built-in OS02G10 sensor for the IMP.
		RVDCONF="$CONF"
		if ! ls /proc/jz/sensor/* >/dev/null 2>&1; then
			cp "$CONF" "$RUNDIR/raptor.conf"
			sed -i '/^\[sensor\]/a name = os02g10' "$RUNDIR/raptor.conf"
			sed -i '/^name = os02g10/a i2c_addr = 0x3c' "$RUNDIR/raptor.conf"
			sed -i '/^i2c_addr = 0x3c/a i2c_adapter = 1' "$RUNDIR/raptor.conf"
			RVDCONF="$RUNDIR/raptor.conf"
		fi

		RVD_ENV=""
		[ -f /usr/lib/libimp_multicam_stub.so ] && RVD_ENV="LD_PRELOAD=/usr/lib/libimp_multicam_stub.so"
		env $RVD_ENV start-stop-daemon -S -b -x /usr/bin/rvd -- -c "$RVDCONF"
		printf "  %-4s started\n" "rvd"
	else
		printf "  %-4s already running\n" "rvd"
	fi

	# Wait for main ring (up to 5 seconds)
	i=0
	while [ $i -lt 50 ] && [ ! -e ${SHMDIR}/rss_ring_main ]; do
		usleep 100000
		i=$((i + 1))
	done

	if [ ! -e ${SHMDIR}/rss_ring_main ]; then
		printf "  rvd  FAILED (no ring after 5s)\n"
		return 1
	fi
	return 0
}

start() {
	echo "Starting Raptor Streaming System..."
	mkdir -p "$RUNDIR"

	if ! start_rvd; then
		exit 1
	fi

	# Audio: preload libimp-nodbg if available to avoid competing IMP debug thread
	RAD_ENV=""
	[ -f /usr/lib/libimp-nodbg.so ] && RAD_ENV="LD_PRELOAD=/usr/lib/libimp-nodbg.so"
	start_daemon rad $RAD_ENV

	# Core daemons
	start_daemon rod
	start_daemon rsd
	start_daemon rsd-555
	start_daemon rhd
	start_daemon ric
	# rmr is started by S33rmr after the SD card is mounted
	start_daemon rmd
	start_daemon rwd
	start_daemon rsp
	start_daemon rsr

	echo "Done."
}

stop_daemon() {
	pid=$(pidof "$1") || return
	kill "$pid" 2>/dev/null
	i=0
	while [ $i -lt 30 ] && kill -0 "$pid" 2>/dev/null; do
		sleep 0.1
		i=$((i + 1))
	done
	if kill -0 "$pid" 2>/dev/null; then
		kill -9 "$pid" 2>/dev/null
		printf "  %-4s killed\n" "$1"
	else
		printf "  %-4s stopped\n" "$1"
	fi
}

stop() {
	echo "Stopping Raptor Streaming System..."

	# Stop consumers first, then producer (RVD) last
	for d in rsr rsp rwd rmd rmr ric rhd rsd rod rad rvd; do
		stop_daemon $d
	done

	# Clean up runtime files
	rm -f "$RUNDIR"/*.pid "$RUNDIR"/*.sock
	rm -f ${SHMDIR}/rss_ring_* ${SHMDIR}/rss_osd_*

	echo "Done."
}

case "$1" in
	start)
		start
		;;
	early)
		start_rvd
		;;
	stop)
		stop
		;;
	restart)
		stop
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

exit 0
