#!/bin/sh
# S99pwrman -- start idle/PIR/network sleep manager.

PIDFILE=/run/pwrman/pwrman.pid
DAEMON=/usr/bin/pwrman

start() {
	[ -x "$DAEMON" ] || return 0
	mkdir -p /run/pwrman
	if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
		return 0
	fi
	start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON"
}

stop() {
	if [ -f "$PIDFILE" ]; then
		start-stop-daemon -K -p "$PIDFILE" -x "$DAEMON" 2>/dev/null || true
		rm -f "$PIDFILE"
	fi
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart) stop; start ;;
	*) echo "Usage: $0 {start|stop|restart}" >&2; exit 1 ;;
esac

exit 0
